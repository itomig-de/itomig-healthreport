{# ITOMIG Healthreport - Upload-Formular #}
{% apply spaceless %}

{% UIContentBlock Standard {'aContainerClasses':['itomig-healthreport']} %}

    {% UITitle ForPage {'sTitle':'Itomig:HealthReport:UI:PageTitle'|dict_s} %}{% EndUITitle %}

    <div class="ibo-v-spacer">&nbsp;</div>

    {% UIContentBlock Standard {'aContainerClasses':['display_block']} %}

        {% UIAlert ForInformation {'sId':'itomig-healthreport-intro','IsCollapsible':false,'IsClosable':false} %}
            {{ 'Itomig:HealthReport:UI:Intro'|dict_s }}
        {% EndUIAlert %}

        {% if sErrorMessage is defined and sErrorMessage %}
            {% UIAlert ForFailure {'sContent':sErrorMessage,'sId':'itomig-healthreport-error','IsCollapsible':false,'IsClosable':true} %}{% EndUIAlert %}
        {% endif %}

        {% UIForm Standard {'sId':'itomig-healthreport-form','Action':sFormAction} %}
            {% UIInput ForHidden {'sName':'transaction_id','sValue':sTransactionId} %}

            {% UIFieldSet Standard {'sLegend':'Itomig:HealthReport:UI:UploadFieldsetLegend'|dict_s} %}

                {% UIField Standard {'sLabel':'Itomig:HealthReport:UI:OrganizationLabel'|dict_s} %}
                    {% UISelect ForSelect {'sName':'org_id','sId':'itomig_healthreport_org','CSSClasses':['ibo-input','ibo-input-select']} %}
                        {% UISelectOption ForSelectOption {'sValue':'','sLabel':'Itomig:HealthReport:UI:OrganizationPlaceholder'|dict_s,'bSelected':(sSelectedOrgId is empty)} %}
                        {% for oOrg in aOrganizations %}
                            {% UISelectOption ForSelectOption {'sValue':(oOrg.id ~ ''),'sLabel':oOrg.name,'bSelected':(sSelectedOrgId == (oOrg.id ~ ''))} %}
                        {% endfor %}
                    {% EndUISelect %}
                {% EndUIField %}

                {% UIField Standard {'sLabel':'Itomig:HealthReport:UI:UploadLabel'|dict_s} %}
                    {% UIFileSelect Standard {'sName':'zip','sId':'itomig_healthreport_zip'} %}
                {% EndUIField %}

            {% EndUIFieldSet %}

            {% UIContentBlock Standard {'aContainerClasses':['ibo-update-core-submit']} %}
                {% UIButton ForPrimaryAction {'sLabel':'Itomig:HealthReport:UI:Submit'|dict_s,'sId':'itomig-healthreport-submit','bIsSubmit':true} %}
                {% UISpinner Standard {'sId':'itomig-healthreport-spinner','IsHidden':true} %}
            {% EndUIContentBlock %}
        {% EndUIForm %}

    {% EndUIContentBlock %}

{% EndUIContentBlock %}

{% endapply %}
